.page {
  min-height: 100vh;
  padding: 48rpx;
}

.panel {
  padding: 48rpx;
  border: 1px solid #d9e2ef;
  border-radius: 16rpx;
  background: #ffffff;
}

.eyebrow {
  display: block;
  font-size: 24rpx;
  color: #4f6f52;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.description {
  display: block;
  font-size: 30rpx;
  line-height: 1.7;
}
